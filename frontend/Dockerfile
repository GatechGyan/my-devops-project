# हम दुनिया का सबसे हल्का और तेज़ वेब सर्वर (Nginx Alpine) बेस इमेज के रूप में ले रहे हैं
FROM nginx:alpine

# हमारी index.html फ़ाइल को Nginx के डिफ़ॉल्ट HTML फ़ोल्डर के अंदर कॉपी कर रहे हैं
COPY index.html /usr/share/nginx/html/

# Nginx का डिफ़ॉल्ट पोर्ट 80 होता है, उसे बाहर की दुनिया के लिए एक्सपोज़ कर रहे हैं
EXPOSE 80

# कंटेनर चालू होते ही Nginx सर्वर को बैकग्राउंड के बजाय फोरग्राउंड में चालू रखने की कमांड
CMD ["nginx", "-g", "daemon off;"]
