# आधिकारिक Node.js का सबसे हल्का (Alpine) वर्जन बेस इमेज के रूप में इस्तेमाल कर रहे हैं
FROM node:18-alpine

# कंटेनर के अंदर अपना वर्किंग फोल्डर सेट कर रहे हैं
WORKDIR /usr/src/app

# अपने लैपटॉप से app.js फाइल को कंटेनर के अंदर कॉपी कर रहे हैं
COPY app.js .

# बैकएंड के पोर्ट को एनवायरनमेंट वेरिएबल के जरिए सेट कर रहे हैं (डिफ़ॉल्ट 5000)
ENV PORT=5000

# इस पोर्ट को बाहर की दुनिया के लिए एक्सपोज़ कर रहे हैं
EXPOSE 5000

# कंटेनर चालू होते ही Node.js सर्वर को रन करने की कमांड
CMD ["node", "app.js"]
