# 🌍 1. नोड.जेएस का एक छोटा और हल्का बेस इमेज इस्तेमाल करें
FROM node:18-alpine

# 📂 2. डिब्बे के अंदर अपना वर्किंग फोल्डर सेट करें
WORKDIR /app

# 📋 3. लाइब्रेरी की लिस्ट को डिब्बे में कॉपी करें
COPY package*.json ./

# 📥 4. कोड चलाने के लिए ज़रूरी एक्सप्रेस लाइब्रेरी इंस्टॉल करें
RUN npm install

# 🚚 5. पेमेंट का बाकी सारा कोड डिब्बे के अंदर ट्रांसफर करें
COPY . .

# 🔌 6. डिब्बे का पोर्ट 5002 बाहरी दुनिया के लिए खोलें
EXPOSE 5002

# 🚀 7. कंटेनर चालू होते ही सर्वर को रन करने की कमांड
CMD ["npm", "start"]
